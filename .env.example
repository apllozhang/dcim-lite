# rebuild 本地/部署环境变量模板
# 复制为 .env 后按需修改；禁止提交真实生产口令。

APP_ENV=development
HTTP_ADDR=:8080

# 必填
DATABASE_URL=postgres://cabinet:change-me@127.0.0.1:5432/cabinet?sslmode=disable
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-bytes

# 首启种子管理员（仅当用户不存在时创建）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeMe#Rebuild1!
ADMIN_DISPLAY_NAME=系统管理员

# JWT 有效期（秒），旧系统实测 7200
JWT_TTL_SECONDS=7200

# migration 目录（容器内默认 /app/migrations）
# MIGRATIONS_DIR=migrations
