# 受限镜像源环境使用：复用服务器已有的 alpine:latest 基础镜像 + 预构建二进制
# 二进制构建：GOOS=linux GOARCH=amd64 go build -o bin/cabinet-server-linux ./cmd/server
FROM alpine:latest
RUN apk add --no-cache ca-certificates tzdata
WORKDIR /app
COPY bin/cabinet-server-linux /app/cabinet-server
COPY migrations /app/migrations
RUN chmod +x /app/cabinet-server
ENV MIGRATIONS_DIR=/app/migrations \
    HTTP_ADDR=:8080 \
    APP_ENV=production
EXPOSE 8080
USER nobody
ENTRYPOINT ["/app/cabinet-server"]
