# 复制为 .env 并按环境填写;真实口令/密钥不入仓库
# —— 网络 ——
# 上游 backend 所在 docker 网络(compose 的 backend 服务名在该网络内解析)。
# 203 dev 栈为 cabinet-rebuild-dev_default;独立栈可自建网络并把 backend 纳入。
ALE_UPSTREAM_NETWORK=cabinet-rebuild-dev_default
# 对外端口(现网 19500)
ALE_APP_PORT=19500
# 版本标签(建议 git sha 或语义版本;与镜像 digest 一同登记到发布记录)
APP_RELEASE=dev
